{
  "schema_version": 1,
  "functions": [
    {
      "id": "act.document.download",
      "category": "backend_core",
      "title": "Download a safe document",
      "description": "Download one HTTP(S) document or image into the fixed Eidolon Act workspace downloads folder. Use this instead of direct download commands.",
      "risk_level": "medium",
      "mcp_exposed": true,
      "agent_selectable": false,
      "mcp_read_only": false,
      "mcp_destructive": false,
      "mcp_open_world": true,
      "input_schema": {"type": "object", "properties": {"source": {"type": "object", "properties": {"kind": {"type": "string", "const": "url"}, "url": {"type": "string", "minLength": 1, "maxLength": 2048}}, "required": ["kind", "url"], "additionalProperties": false}, "filename": {"type": "string", "minLength": 1, "maxLength": 180}}, "required": ["source"], "additionalProperties": false},
      "output_schema": {"type": "object", "properties": {"path": {"type": "string"}, "filename": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string"}}, "required": ["path", "filename", "bytes", "media_type"], "additionalProperties": false}
    },
    {
      "id": "backend.codex.call",
      "category": "backend_core",
      "title": "Skill Codex Call",
      "description": "Ask Eidolon to make one bounded Codex call from an installed skill.",
      "risk_level": "low",
      "mcp_exposed": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "codex_permissions": {
            "type": "object",
            "properties": {
              "call_response": {
                "const": true
              },
              "internet_access": {
                "type": "boolean"
              }
            },
            "required": [
              "call_response"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "prompt",
          "context",
          "codex_permissions"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "response": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "internet_access": {
            "type": "boolean"
          }
        },
        "required": [
          "response",
          "model",
          "internet_access"
        ],
        "additionalProperties": false
      },
      "invocation": {
        "function_helper": "function_runtime_capabilities.call_codex(prompt, context=..., model=..., internet_access=...)",
        "web_app_helper": "web_runtime_capabilities.call_codex(prompt=..., context=..., internet_access=...)",
        "test_guidance": "Mock the backend helper. Do not shell out to Codex.",
        "rules": [
          "Batch multi-item work into one bounded Codex request.",
          "internet_access=true requires approved runtime network access.",
          "Shell and arbitrary filesystem access are not available."
        ]
      }
    }
  ]
}
