{
  "schema_version": 1,
  "functions": [
    {
      "id": "backend.codex.call",
      "category": "backend_core",
      "title": "Skill Codex Call",
      "description": "Ask Eidolon to make one bounded Codex call from an installed skill.",
      "risk_level": "low",
      "mcp_exposed": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "codex_permissions": {
            "type": "object",
            "properties": {
              "call_response": {
                "const": true
              },
              "internet_access": {
                "type": "boolean"
              }
            },
            "required": [
              "call_response"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "prompt",
          "context",
          "codex_permissions"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "response": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "internet_access": {
            "type": "boolean"
          }
        },
        "required": [
          "response",
          "model",
          "internet_access"
        ],
        "additionalProperties": false
      },
      "invocation": {
        "function_helper": "function_runtime_capabilities.call_codex(prompt, context=..., model=..., internet_access=...)",
        "web_app_helper": "web_runtime_capabilities.call_codex(prompt=..., context=..., internet_access=...)",
        "test_guidance": "Mock the backend helper. Do not shell out to Codex.",
        "rules": [
          "Batch multi-item work into one bounded Codex request.",
          "internet_access=true requires approved runtime network access.",
          "Shell and arbitrary filesystem access are not available."
        ]
      }
    },
    {
      "id": "backend.notion.todo.cleanup_done",
      "category": "backend_core",
      "title": "Daily Notion Done Cleanup",
      "description": "Move todos with the Done checkbox selected from the configured Notion data source to trash.",
      "risk_level": "medium",
      "mcp_exposed": false,
      "scheduler_only": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["succeeded", "partial", "failed"]
          },
          "scanned_count": {"type": "integer", "minimum": 0},
          "matched_count": {"type": "integer", "minimum": 0},
          "deleted_count": {"type": "integer", "minimum": 0},
          "deleted_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {"type": "string"}
          },
          "deleted_ids_truncated": {"type": "boolean"},
          "failures": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": ["string", "null"]},
                "error_type": {"type": "string"}
              },
              "required": ["id", "error_type"],
              "additionalProperties": false
            }
          },
          "failures_truncated": {"type": "boolean"},
          "error_type": {"type": ["string", "null"]}
        },
        "required": [
          "status",
          "scanned_count",
          "matched_count",
          "deleted_count",
          "deleted_ids",
          "deleted_ids_truncated",
          "failures",
          "failures_truncated",
          "error_type"
        ],
        "additionalProperties": false
      },
      "invocation": {
        "rules": [
          "Registered automatically by SchedulerService.",
          "Unavailable to ProductManager, skills, direct API callers, and Codex MCP."
        ]
      }
    }
  ]
}
