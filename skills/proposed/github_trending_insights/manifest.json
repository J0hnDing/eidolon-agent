{
  "name": "github_trending_insights",
  "display_name": "GitHub Trending Insights",
  "description": "Retrieve up to 10 ranked GitHub Trending repositories and produce a structured, batch-analyzed weekly report.",
  "skill_type": "automation",
  "interface_type": "hidden",
  "entrypoint": "skill.py",
  "instructions_path": "SKILL.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "default": ""
      },
      "since": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "monthly"
        ],
        "default": "weekly"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 10
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "source",
      "projects",
      "failures"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "failed"
        ]
      },
      "source": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "url",
              "since",
              "language"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "since": {
                "type": "string"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "projects": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "rank",
            "identifier",
            "url",
            "description",
            "primary_language",
            "stars",
            "forks",
            "recent_stars",
            "metadata_missing",
            "analysis"
          ],
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "identifier": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "primary_language": {
              "type": [
                "string",
                "null"
              ]
            },
            "stars": {
              "type": [
                "integer",
                "null"
              ]
            },
            "forks": {
              "type": [
                "integer",
                "null"
              ]
            },
            "recent_stars": {
              "type": [
                "integer",
                "null"
              ]
            },
            "metadata_missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "analysis": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "purpose",
                    "notable_qualities",
                    "likely_use_cases",
                    "potential_limitations"
                  ],
                  "properties": {
                    "purpose": {
                      "type": "string"
                    },
                    "notable_qualities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "likely_use_cases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "potential_limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "failures": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "additionalProperties": false
  },
  "tool_ui_schema": null,
  "dependencies": [],
  "risk_level": "medium",
  "permissions": {
    "network": [
      "github.com"
    ],
    "filesystem_read": [
      "./cache"
    ],
    "filesystem_write": [
      "./cache"
    ],
    "secrets": [],
    "shell": false,
    "codex": {
      "call_response": true,
      "internet_access": false
    }
  },
  "schedule": {
    "type": "weekly",
    "day": "monday",
    "time": "09:00",
    "timezone": "America/Toronto",
    "input": {
      "language": "",
      "since": "weekly",
      "limit": 10
    }
  },
  "created_by": "codex",
  "enabled": false
}