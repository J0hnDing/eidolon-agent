        "required": true,
        "default": "generate",
        "options": [
          "generate",
          "check"
        ]
      },
      {
        "name": "difficulty",
        "label": "Difficulty",
        "type": "select",
        "placeholder": "",
        "help_text": "Used when generating a new puzzle.",
        "required": false,
        "default": "medium",
        "options": [
          "easy",
          "medium",
          "hard"
        ]
      },
      {
        "name": "puzzle",
        "label": "Puzzle",
        "type": "textarea",
        "placeholder": "81 characters using 0 or . for blanks",
        "help_text": "Required when checking a solution or requesting a hint.",
        "required": false,
        "default": ""
      },
      {
        "name": "solution",
        "label": "Solution",
        "type": "textarea",
        "placeholder": "81 digits, one row after another",
        "help_text": "Required when checking a completed puzzle.",
        "required": false,
        "default": ""
      },
      {
        "name": "include_hint",
        "label": "Include Hint",
        "type": "checkbox",
        "placeholder": "",
        "help_text": "Return one safe next-cell hint when possible.",
        "required": false,
        "default": false
      }
    ],
    "result_template": {
      "primary_field": "message",
      "primary_label": "Result"
    }
  },
  "dependencies": [],
  "risk_level": "low",
  "permissions": {
    "network": [],
