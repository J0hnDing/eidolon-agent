{
  "name": "sudoku_game",
  "display_name": "Sudoku Game",
  "description": "Generate local Sudoku puzzles, validate completed grids, and return optional hints without network access.",
  "skill_type": "automation",
  "interface_type": "tool",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "generate",
          "check"
        ]
      },
      "difficulty": {
        "type": "string",
        "enum": [
          "easy",
          "medium",
          "hard"
        ]
      },
      "puzzle": {
        "type": "string",
        "description": "81-character Sudoku puzzle using digits 1-9 and 0 or . for blanks"
      },
      "solution": {
        "type": "string",
        "description": "81-character attempted solution using digits 1-9"
      },
      "include_hint": {
        "type": "boolean"
      }
    },
    "required": [
      "mode"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "puzzle": {
        "type": [
          "string",
          "null"
        ]
      },
      "grid": {
        "type": [
          "string",
          "null"
        ]
      },
      "difficulty": {
        "type": [
          "string",
          "null"
        ]
      },
      "is_valid": {
        "type": "boolean"
      },
      "is_complete": {
        "type": "boolean"
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "hint": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": "string"
      }
    },
    "required": [
      "is_valid",
      "is_complete",
      "errors",
      "message"
    ],
    "additionalProperties": false
  },
  "tool_ui_schema": {
    "title": "Sudoku Game",
    "description": "Generate a Sudoku puzzle or check a completed Sudoku grid locally.",
    "submit_label": "Run",
    "fields": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "select",
        "placeholder": "",
