{
  "name": "weather_outfit_planner",
  "display_name": "Weather Outfit Planner",
  "description": "Fetches current weather from wttr.in for a user-provided city and returns concise outfit guidance with commute flags.",
  "skill_type": "automation",
  "interface_type": "tool",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "city",
      "units"
    ],
    "properties": {
      "city": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "City name to check weather for."
      },
      "units": {
        "type": "string",
        "enum": [
          "metric",
          "imperial"
        ],
        "description": "Temperature unit system."
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "recommendation",
      "umbrella",
      "jacket",
      "temperature",
      "condition",
      "commute_note"
    ],
    "properties": {
      "recommendation": {
        "type": "string"
      },
      "umbrella": {
        "type": "boolean"
      },
      "jacket": {
        "type": "boolean"
      },
      "temperature": {
        "type": "number"
      },
      "condition": {
        "type": "string"
      },
      "commute_note": {
        "type": "string"
      }
    }
  },
  "tool_ui_schema": {
    "title": "Weather Outfit Planner",
    "description": "Fetches current weather for a city and suggests what to wear for a commute.",
    "submit_label": "Plan Outfit",
    "fields": [
      {
        "name": "city",
        "label": "City",
        "type": "text",
        "placeholder": "Toronto",
        "help_text": "Enter a city name supported by wttr.in.",
        "required": true,
        "default": ""
      },
      {
        "name": "units",
        "label": "Units",
        "type": "select",
        "placeholder": "",
        "help_text": "Choose how temperatures should be shown.",
        "required": true,
        "default": "metric",
        "options": [
          "metric",
          "imperial"
        ]
      }
    ],
    "result_template": {
      "primary_field": "recommendation",
      "primary_label": "Outfit Recommendation",
      "secondary_fields": [
        {
          "field": "commute_note",
          "label": "Commute Note"
        },
        {
          "field": "temperature",
          "label": "Temperature"
        },
        {
          "field": "condition",
          "label": "Condition"
        },
        {
          "field": "umbrella",
          "label": "Umbrella"
        },
        {
          "field": "jacket",
          "label": "Jacket"
        }
      ]
    }
  },
  "dependencies": [
    "requests"
  ],
  "risk_level": "medium",
  "permissions": {
    "network": [
      "wttr.in"
    ],
    "filesystem_read": [],
    "filesystem_write": [],
    "secrets": [],
    "shell": false
  },
  "schedule": null,
  "created_by": "codex",
  "enabled": false
}
