{
  "manifest_version": 1,
  "name": "persistent_counter",
  "display_name": "Persistent Counter",
  "description": "Provide a simple reusable local-first counter web application that preserves its current count between uses.",
  "runtime": "web_app",
  "entrypoint": "app:app",
  "instructions_path": null,
  "input_schema": null,
  "output_schema": null,
  "dependencies": [],
  "permissions": {
    "network": [],
    "filesystem_read": [
      "./cache"
    ],
    "filesystem_write": [
      "./cache"
    ],
    "secrets": [],
    "shell": false,
    "codex": {
      "internet_access": false
    }
  },
  "schedule": null
}
