{
  "manifest_version": 1,
  "name": "github_atlas_project_scout",
  "description": "Enrich GitHub's actual trending repositories with concise Codex analysis grounded in their READMEs and local Atlas projects.",
  "runtime": "function",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 25,
        "default": 10,
        "description": "Maximum number of trending repositories to compare."
      },
      "language": {
        "type": "string",
        "minLength": 1,
        "description": "Optional programming-language filter."
      },
      "period": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "monthly"
        ],
        "default": "weekly",
        "description": "GitHub Trending period."
      },
      "atlas_keywords": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 20,
        "default": [],
        "description": "Optional keywords used to narrow Atlas projects."
      },
      "analysis_focus": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "Optional guidance for the comparison and recommendations."
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "repositories": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "GitHub repository full name from the integration result."
            },
            "url": {
              "type": "string",
              "description": "GitHub repository URL from the integration result."
            },
            "stars": {
              "type": "integer",
              "minimum": 0,
              "description": "GitHub star count from the integration result."
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Repository description from the GitHub integration result."
            },
            "analysis": {
              "type": "string",
              "minLength": 1,
              "description": "Concise Codex analysis of the project's principle, notable ideas, and realistic relevance or lessons."
            }
          },
          "required": [
            "name",
            "url",
            "stars",
            "description",
            "analysis"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "repositories"
    ],
    "additionalProperties": false
  },
  "function_requirements": [],
  "integration_requirements": [
    {
      "provider": "atlas",
      "operations": [
        "atlas.project.list"
      ],
      "resource_scope": {}
    },
    {
      "provider": "github",
      "operations": [
        "github.repository.trending.list"
      ],
      "resource_scope": {
        "repositories": []
      }
    }
  ],
  "dependencies": [],
  "permissions": {
    "network": [],
    "filesystem_read": [],
    "filesystem_write": [],
    "secrets": [],
    "shell": false,
    "codex": {
      "call_response": true,
      "internet_access": false
    }
  },
  "schedule": null
}
