{
  "manifest_version": 1,
  "name": "macro_geopolitical_news_scout",
  "description": "Select material macroeconomic, policy, energy, sanctions, and geopolitical news for a caller-owned report.",
  "runtime": "function",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "last_fetch_at": {"type": ["string", "null"], "maxLength": 64},
      "seen": {"type": "array", "maxItems": 5000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
      "report": {"type": ["object", "null"]}
    },
    "required": ["last_fetch_at", "seen", "report"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "report": {
        "type": "object",
        "properties": {
          "macro_picture": {"type": "string", "maxLength": 700},
          "items": {
            "type": "array", "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "what_happened": {"type": "string", "minLength": 1, "maxLength": 450},
                "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 500},
                "new_since_previous": {"type": "string", "minLength": 1, "maxLength": 350},
                "watch_next": {"type": "string", "minLength": 1, "maxLength": 350},
                "sources": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "pattern": "^https://", "maxLength": 1800}}
              },
              "required": ["what_happened", "why_it_matters", "new_since_previous", "watch_next", "sources"],
              "additionalProperties": false
            }
          },
          "upcoming_catalysts": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 250}}
        },
        "required": ["macro_picture", "items", "upcoming_catalysts"],
        "additionalProperties": false
      },
      "seen": {"type": "array", "maxItems": 232, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
      "candidate_count": {"type": "integer", "minimum": 0, "maximum": 100},
      "source_failures": {"type": "array", "items": {"type": "string"}, "maxItems": 19},
      "last_fetch_at": {"type": "string", "minLength": 1}
    },
    "required": ["report", "seen", "candidate_count", "source_failures", "last_fetch_at"],
    "additionalProperties": false
  },
  "function_requirements": [],
  "integration_requirements": [
    {"provider": "fred", "operations": ["fred.release.list"], "resource_scope": {}},
    {"provider": "bls", "operations": ["bls.series.latest"], "resource_scope": {}},
    {"provider": "bea", "operations": ["bea.series.latest"], "resource_scope": {}},
    {"provider": "eia", "operations": ["eia.series.latest"], "resource_scope": {}},
    {"provider": "atlas", "operations": ["atlas.goal.list", "atlas.project.list", "atlas.interest.list"], "resource_scope": {}}
  ],
  "dependencies": [],
  "permissions": {
    "network": ["www.federalreserve.gov", "www.bls.gov", "apps.bea.gov", "www150.statcan.gc.ca", "www.bankofcanada.ca", "www.ecb.europa.eu", "www.eia.gov"],
    "filesystem_read": [],
    "filesystem_write": [],
    "secrets": [],
    "shell": false,
    "codex": {"call_response": true, "internet_access": true}
  }
}
