{
  "manifest_version": 1,
  "name": "github_repo_scout",
  "description": "Select genuinely useful or interesting repositories from GitHub Trending with optional Atlas personalization context.",
  "runtime": "function",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 25,
        "default": 25,
        "description": "Maximum number of trending repositories to retrieve."
      },
      "language": {
        "type": "string",
        "minLength": 1,
        "description": "Optional programming-language filter."
      },
      "period": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "monthly"
        ],
        "default": "weekly",
        "description": "GitHub Trending period."
      },
      "excluded_repo": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s/]+/[^\\s/]+$"
        },
        "maxItems": 1000,
        "default": [],
        "description": "Previously recommended repository full names to exclude before personalization."
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "repositories": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "GitHub repository full name from the integration result."
            },
            "url": {
              "type": "string",
              "description": "GitHub repository URL from the integration result."
            },
            "stars": {
              "type": "integer",
              "minimum": 0,
              "description": "GitHub star count from the integration result."
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Repository description from the GitHub integration result."
            },
            "analysis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Concise Codex analysis explaining why the selected repository is worth checking out."
            }
          },
          "required": [
            "name",
            "url",
            "stars",
            "description",
            "analysis"
          ],
          "additionalProperties": false
        },
        "maxItems": 6
      },
      "seen_repo": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s/]+/[^\\s/]+$",
          "description": "GitHub repository full name considered after exclusions and cleanup."
        },
        "maxItems": 15,
        "description": "The first 15 unique repositories remaining after excluded_repo is removed, in deterministic Trending order."
      }
    },
    "required": [
      "repositories",
      "seen_repo"
    ],
    "additionalProperties": false
  },
  "function_requirements": [],
  "integration_requirements": [
    {
      "provider": "github",
      "operations": [
        "github.repository.trending.list"
      ],
      "resource_scope": {
        "repositories": []
      }
    },
    {
      "provider": "atlas",
      "operations": [
        "atlas.goal.list",
        "atlas.project.list",
        "atlas.interest.list"
      ],
      "resource_scope": {}
    }
  ],
  "dependencies": [],
  "permissions": {
    "network": [],
    "filesystem_read": [],
    "filesystem_write": [],
    "secrets": [],
    "shell": false,
    "codex": {
      "call_response": true,
      "internet_access": false
    }
  },
  "schedule": null
}
