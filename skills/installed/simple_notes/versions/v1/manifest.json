{
  "manifest_version": 1,
  "name": "simple_notes",
  "display_name": "Simple Notes",
  "description": "Provide a reusable local-first notes application for creating, viewing, and deleting notes through a pleasant self-rendered web interface.",
  "runtime": "web_app",
  "entrypoint": "app:app",
  "instructions_path": null,
  "input_schema": null,
  "output_schema": null,
  "dependencies": [],
  "permissions": {
    "network": [],
    "filesystem_read": [
      "./cache"
    ],
    "filesystem_write": [
      "./cache"
    ],
    "secrets": [],
    "shell": false,
    "codex": {
      "internet_access": false
    }
  },
  "schedule": null
}