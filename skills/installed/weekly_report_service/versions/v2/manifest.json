{
  "manifest_version": 1,
  "name": "weekly_report_service",
  "description": "Create deterministic weekly GitHub Projects and AI Research Notion reports from the installed scout functions.",
  "runtime": "service",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "report": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "name": {"type": "string", "minLength": 1, "maxLength": 2000},
          "created_time": {"type": "string", "minLength": 1, "maxLength": 64},
          "select": {"type": "string", "const": "GitHub Projects"}
        },
        "required": ["id", "name", "created_time", "select"],
        "additionalProperties": false
      },
      "repository_count": {"type": "integer", "minimum": 0, "maximum": 6},
      "research_report": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "name": {"type": "string", "minLength": 1, "maxLength": 2000},
          "created_time": {"type": "string", "minLength": 1, "maxLength": 64},
          "select": {"type": "string", "const": "AI Research"}
        },
        "required": ["id", "name", "created_time", "select"],
        "additionalProperties": false
      },
      "paper_count": {"type": "integer", "minimum": 0, "maximum": 5}
    },
    "required": ["report", "repository_count", "research_report", "paper_count"],
    "additionalProperties": false
  },
  "function_requirements": ["github_repo_scout", "research_paper_scout"],
  "integration_requirements": [
    {
      "provider": "notion",
      "operations": ["notion.report.create"],
      "resource_scope": {}
    },
    {
      "provider": "telegram",
      "operations": ["telegram.notification.send"],
      "resource_scope": {}
    }
  ],
  "dependencies": [],
  "permissions": {
    "network": [],
    "filesystem_read": ["./cache"],
    "filesystem_write": ["./cache"],
    "secrets": [],
    "shell": false,
    "codex": {
      "call_response": false,
      "internet_access": false
    }
  },
  "schedule": {
    "type": "weekly",
    "day": "monday",
    "time": "08:00",
    "timezone": "America/Toronto",
    "input": {}
  }
}
