{
  "manifest_version": 1,
  "name": "research_paper_scout",
  "description": "Analyze the unseen papers among Hugging Face's six most-upvoted papers for the current month.",
  "runtime": "function",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "seen_papers": {
        "type": "array",
        "maxItems": 5000,
        "default": [],
        "items": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{4,5}(?:v[1-9][0-9]*)?$"
        },
        "description": "Stable paper IDs already evaluated by the calling service and excluded before Codex selection."
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "selected_papers": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "properties": {
            "rank": {"type": "integer", "minimum": 1, "maximum": 6},
            "paper_id": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"},
            "title": {"type": "string", "minLength": 1, "maxLength": 2000},
            "authors": {
              "type": "array",
              "maxItems": 100,
              "items": {"type": "string", "minLength": 1, "maxLength": 500}
            },
            "abstract": {"type": "string", "maxLength": 50000},
            "url": {"type": "string", "minLength": 9, "maxLength": 4000},
            "pdf_url": {"type": "string", "minLength": 9, "maxLength": 4000},
            "published_at": {"type": ["string", "null"], "maxLength": 64},
            "organization": {"type": ["string", "null"], "maxLength": 500},
            "upvotes": {"type": "integer", "minimum": 0},
            "analysis": {"type": "string", "minLength": 1, "maxLength": 2000},
            "content_source": {"enum": ["arxiv_html", "arxiv_pdf"]},
            "source_content_truncated": {"type": "boolean"},
            "analysis_content_truncated": {"type": "boolean"}
          },
          "required": [
            "rank", "paper_id", "title", "authors", "abstract", "url", "pdf_url", "published_at", "organization",
            "upvotes", "analysis", "content_source", "source_content_truncated", "analysis_content_truncated"
          ],
          "additionalProperties": false
        }
      },
      "seen_papers": {
        "type": "array",
        "maxItems": 6,
        "items": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"},
        "description": "Successfully analyzed paper IDs to add to the caller's history."
      }
    },
    "required": ["selected_papers", "seen_papers"],
    "additionalProperties": false
  },
  "requires_invocation_approval": false,
  "function_requirements": [],
  "integration_requirements": [
    {
      "provider": "huggingface",
      "operations": ["huggingface.list_papers", "huggingface.get_paper"],
      "resource_scope": {}
    }
  ],
  "dependencies": [],
  "permissions": {
    "codex": {
      "call_response": true,
      "internet_access": false
    }
  },
  "schedule": null
}
