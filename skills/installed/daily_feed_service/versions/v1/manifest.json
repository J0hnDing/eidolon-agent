{
  "manifest_version": 1,
  "name": "daily_feed_service",
  "description": "Replace one Notion Daily Feed page each morning with deterministic Toronto weather, clothing guidance, today's calendar, and the next three days of todos.",
  "runtime": "service",
  "entrypoint": "skill.py",
  "instructions_path": null,
  "input_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "page_updated": {
        "type": "boolean",
        "const": true
      },
      "characters": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "event_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      },
      "todo_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "required": ["date", "page_updated", "characters", "event_count", "todo_count"],
    "additionalProperties": false
  },
  "function_requirements": [],
  "integration_requirements": [
    {
      "provider": "notion",
      "operations": ["notion.todo.list", "notion.daily_feed.write"],
      "resource_scope": {}
    },
    {
      "provider": "google_calendar",
      "operations": ["google_calendar.event.list"],
      "resource_scope": {}
    }
  ],
  "dependencies": [],
  "permissions": {
    "network": ["api.open-meteo.com"],
    "filesystem_read": [],
    "filesystem_write": [],
    "secrets": [],
    "shell": false,
    "codex": {
      "call_response": false,
      "internet_access": false
    }
  },
  "schedule": {
    "type": "daily",
    "time": "08:30",
    "timezone": "America/Toronto",
    "input": {}
  }
}
